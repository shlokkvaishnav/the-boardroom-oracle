# Copy to `.env` and fill in. `.env` is gitignored.

# --- Gemini ---
# Required for real agent turns. The test suite mocks every LLM call, so tests
# pass without it, and the service falls back to mock agents if it's absent.
GEMINI_API_KEY=
# Free-tier eligibility and limits change — check the current list at
# https://aistudio.google.com/rate-limit before a demo.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Free-tier rate limiting ---
# Calls are serialized with at least this gap between them. The free tier is
# limited per minute (historically ~15 RPM on flash), and a round fires one
# call per persona, so 4s keeps a 3-agent round comfortably inside the budget.
LLM_MIN_INTERVAL_SECONDS=4.0
# Attempts per call on 429/5xx, including the first.
LLM_MAX_ATTEMPTS=3
# First backoff wait; doubles each attempt (2s, 4s, ...).
LLM_BACKOFF_BASE_SECONDS=2.0
LLM_TIMEOUT_SECONDS=60.0

# Force mock agents even with a key — rehearse without spending quota.
USE_MOCK_AGENTS=false

# --- The scribe ---
# Once per round with claims in it, a pass reads the round and links claims that
# support or contradict each other. Agents report their own claims, but only
# something reading the whole table can see that Rex's number answers Ada's.
# Runs as a background task after the round closes — never inside a turn — and
# spends only the call budget's surplus, so it can never delay the ending.
ENABLE_SCRIBE=true
# Extraction, not reasoning: a small model does this well and keeps it from
# competing with the negotiators for the same per-minute budget. Blank uses
# GEMINI_MODEL.
SCRIBE_MODEL=gemini-3.6-flash-lite
# How long the closing waits for a pass still in flight before cancelling it.
SCRIBE_SETTLE_TIMEOUT_SECONDS=10.0

# Most provider calls one session may spend, across every feature that makes
# them. 0 means unlimited. Three agents over six rounds is 18 calls to merely
# finish, or 36 when a topic is set and each turn also spends a search probe —
# so 60 never binds on a normal session. What it buys: the calls needed to reach
# the closing are reserved first, and optional work (search now, more later)
# only ever spends the surplus. A session can end early; it always ends.
SESSION_CALL_BUDGET=60

# --- CORS ---
# Comma-separated. Add the frontend's deployed URL here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Dev escape hatch: allow any origin. Never enable this in a deployed setting.
CORS_ALLOW_ALL=false

# --- Negotiation ---
ROUNDS=6
# Demo pacing and rate-limit headroom in one dial. Also reads as agents thinking.
TURN_DELAY_SECONDS=2.5
POOL_RESOURCE=budget
POOL_TOTAL=100.0

# --- Sessions ---
# How many negotiations may run at once. Raising this does NOT make anything
# faster: every agent call from every session queues behind the same global
# rate-limit slot, so more sessions means slower rounds for all of them.
MAX_CONCURRENT_SESSIONS=5
# A session nobody has touched for this long is swept and its loop stopped.
SESSION_TTL_SECONDS=600
SESSION_SWEEP_INTERVAL_SECONDS=60

# --- Groq (hosted Whisper) ---
# With a key, voice transcription goes to Groq's hosted Whisper: roughly 200x
# realtime and far more accurate than anything that runs on this CPU. Without
# one, the local faster-whisper model handles it — and the local model is also
# the fallback whenever Groq errors or is unreachable, so voice never breaks.
# Free tier: ~20 requests/min, 2000/day, 25MB per file.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# -turbo is ~2x the throughput of plain large-v3 for a small accuracy cost.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=20.0

# --- Live web search (agent tool) ---
# Enables the agents' `web_search` tool, which is only offered when a session is
# started with a `context_topic`. Without a key, a context_topic session still
# runs — the agents just can't look anything up.
TAVILY_API_KEY=
# Results per search. Every hit is pasted into the follow-up prompt, so this is
# really a prompt-size dial rather than a quality one.
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT_SECONDS=10.0

# --- Speech-to-text (faster-whisper) ---
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
# Load the model at startup instead of on first request, so the first voice
# offer of the demo isn't a cold model download.
WHISPER_PRELOAD=true
# Pin the language to skip auto-detection. Blank to detect.
WHISPER_LANGUAGE=en
