# Copy to `.env` and fill in. `.env` is gitignored.

# --- Anthropic ---
# Required for real agent turns (milestone 5+). The test suite mocks every LLM
# call, so tests pass without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — controls reasoning depth and therefore
# per-turn latency. `low` keeps the live demo moving.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048

# --- CORS ---
# Comma-separated. Add the Lovable preview URL here once it exists.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Dev escape hatch: allow any origin. Never enable this in a deployed setting.
CORS_ALLOW_ALL=false

# --- Negotiation ---
ROUNDS=6
TURN_DELAY_SECONDS=3.0
POOL_RESOURCE=budget
POOL_TOTAL=100.0

# --- Speech-to-text (faster-whisper) ---
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# Load the model at startup instead of on first request, so the first voice
# offer of the demo isn't a cold model download.
WHISPER_PRELOAD=false
