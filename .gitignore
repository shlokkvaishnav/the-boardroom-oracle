# --- Source archives (the frontend export is ~107MB, mostly a bundled venv) ---
*.zip

# --- Frontend (tracked; only its build output and deps are ignored) ---
node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo

# --- Secrets ---
.env
*.env
!*.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# --- Model / tooling caches ---
.cache/
huggingface/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
